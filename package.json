{
    "name": "envnix",
    "version": "0.0.2",
    "description": "Generate .env.example files from existing .env files while preserving formatting and comments.",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "envnix": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "typecheck": "tsc --noEmit",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "release": "pnpm run build && changeset publish"
    },
    "keywords": [
        "env",
        "dotenv",
        "env-example",
        "generator",
        "cli"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "chokidar": "^5.0.0",
        "commander": "^15.0.0",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@types/node": "^26.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "^5.6.3"
    }
}
